# ── Required ──────────────────────────────────────────────

# Supabase (server-side — service_role key for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Optional — Frontend Supabase client ─────────────────
# Needed only for AI sibling context, @mentions, and realtime sync.
# Core CRUD works without them (uses server API).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Optional — Cloudflare R2 (asset storage) ─────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Optional — GitHub feedback integration ──────────────
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ── Optional — Guest mode ───────────────────────────────
VITE_ENABLE_GUEST_MODE=true

# ── Optional — Server ───────────────────────────────────
PORT=3000
VITE_API_URL=
