# ── Required ──────────────────────────────────────────────

# ── Option A: Supabase PostgreSQL (production/cloud) ──
# DATABASE_URL="postgresql://user:pass@host:5432/db?pgbouncer=true&connection_limit=10"
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Option B: Local PostgreSQL (no Supabase dependency) ──
# 1. Install PostgreSQL, create a database:
#    createdb erd_builder_pro
# 2. Set DATABASE_URL below (no SUPABASE_URL needed)
# 3. Run: npm run db:push:pg:local
# 4. Run: npm run dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erd_builder_pro"
# Required for web/server deployments; use the same value across all instances.
# ERD_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
# Desktop/SQLite generates the key beside data.db when this is omitted.
# ERD_ENCRYPTION_KEY_FILE=/secure/path/erd-encryption-key

# ── Optional — Frontend Supabase client ─────────────────
# Needed only for AI sibling context, @mentions, and realtime sync.
# Not needed for local PostgreSQL setup.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Optional — Cloudflare R2 (asset storage) ─────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Optional — GitHub feedback integration ──────────────
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ── Optional — Guest mode (disabled by default) ─────────
# Set to true to enable guest login. Default: false.
# VITE_ENABLE_GUEST_MODE=true
#
# Allow guest users to use AI Chat via the server proxy.
# WARNING: guests will consume your configured AI provider API keys.
# Default: false.
# GUEST_AI_ENABLED=true

# ── Optional — private AI endpoints ─────────────────────
# Keep disabled for SSRF protection. Set true only when using a trusted
# internal endpoint such as Ollama on the same machine/network.
# AI_ALLOW_PRIVATE_BASE_URL=true

# ── Optional — Frontend API URL ─────────────────────────
# Defaults: Vite proxy in dev, relative URLs in prod web, localhost:3000 for Tauri
PORT=3000
# VITE_API_URL=

# ── Optional — CORS allowed origins ─────────────────────
# Only needed for custom domains (NOT Vercel deployments)
# Vercel domains (*.vercel.app) are allowed by default
# Format: comma-separated HTTPS URLs (no trailing slash)
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CORS_ORIGINS=
