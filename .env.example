# ── Required ──────────────────────────────────────────────

# Prisma (Supabase PostgreSQL via session pooler)
DATABASE_URL="database_url"

# Supabase (server-side — service_role key for admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Auth uses Supabase session JWTs stored in an httpOnly cookie.
# No local JWT_SECRET, ADMIN_EMAIL, or ADMIN_PASSWORD is needed.

# ── Optional — Frontend Supabase client ─────────────────
# Needed only for AI sibling context, @mentions, and realtime sync.
# Core CRUD works without them (uses server API).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# ── Optional — Cloudflare R2 (asset storage) ─────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Optional — GitHub feedback integration ──────────────
# GITHUB_TOKEN=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=

# ── Optional — Guest mode ───────────────────────────────
VITE_ENABLE_GUEST_MODE=true

# ── Optional ── Frontend API URL (defaults to localhost:3000 in production/Tauri, Vite proxy in browser dev)
PORT=3000
VITE_API_URL=
