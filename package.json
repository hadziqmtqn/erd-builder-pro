    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@supabase/supabase-js": "^2.101.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
