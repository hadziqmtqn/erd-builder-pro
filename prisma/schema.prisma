generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  instance_id                 String?                @db.Uuid
  id                          String                 @id @default(uuid()) @db.Uuid
  aud                         String?                @db.VarChar(255)
  role                        String?                @db.VarChar(255)
  email                       String?                @db.VarChar(255)
  encrypted_password          String?                @db.VarChar(255)
  emailConfirmedAt            DateTime?              @map("email_confirmed_at") @db.Timestamptz(6)
  invited_at                  DateTime?              @db.Timestamptz(6)
  confirmation_token          String?                @db.VarChar(255)
  confirmation_sent_at        DateTime?              @db.Timestamptz(6)
  recovery_token              String?                @db.VarChar(255)
  recovery_sent_at            DateTime?              @db.Timestamptz(6)
  email_change_token_new      String?                @db.VarChar(255)
  email_change                String?                @db.VarChar(255)
  email_change_sent_at        DateTime?              @db.Timestamptz(6)
  lastSignInAt                DateTime?              @map("last_sign_in_at") @db.Timestamptz(6)
  rawAppMetaData              Json?                  @map("raw_app_meta_data")
  rawUserMetaData             Json?                  @map("raw_user_meta_data")
  isSuperAdmin                Boolean?               @map("is_super_admin")
  createdAt                   DateTime?              @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime?              @map("updated_at") @db.Timestamptz(6)
  phone                       String?                @unique
  phone_confirmed_at          DateTime?              @db.Timestamptz(6)
  phone_change                String?                @default("")
  phone_change_token          String?                @default("") @db.VarChar(255)
  phone_change_sent_at        DateTime?              @db.Timestamptz(6)
  confirmedAt                 DateTime?              @default(dbgenerated("LEAST(email_confirmed_at, phone_confirmed_at)")) @map("confirmed_at") @db.Timestamptz(6)
  email_change_token_current  String?                @default("") @db.VarChar(255)
  email_change_confirm_status Int?                   @default(0) @db.SmallInt
  banned_until                DateTime?              @db.Timestamptz(6)
  reauthentication_token      String?                @default("") @db.VarChar(255)
  reauthentication_sent_at    DateTime?              @db.Timestamptz(6)
  is_sso_user                 Boolean                @default(false)
  deletedAt                   DateTime?              @map("deleted_at") @db.Timestamptz(6)
  is_anonymous                Boolean                @default(false)
  identities                  identities[]
  mfa_factors                 mfa_factors[]
  oauth_authorizations        oauth_authorizations[]
  oauth_consents              oauth_consents[]
  one_time_tokens             one_time_tokens[]
  sessions                    sessions[]
  webauthn_challenges         webauthn_challenges[]
  webauthn_credentials        webauthn_credentials[]
  backups                     Backup[]
  diagrams                    Diagram[]
  drawings                    Drawing[]
  entityChanges               EntityChange[]
  flowcharts                  Flowchart[]
  notes                       Note[]
  projects                    Project[]
  aiConfigs                   UserAiConfig[]
  aiRules                     UserAiRule[]
  preferences                 UserPreference?

  @@index([instance_id])
  @@index([is_anonymous])
  @@map("users")
  @@schema("auth")
}

model Project {
  id         BigInt          @id @default(autoincrement())
  uid        String?         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  userId     String?         @map("user_id") @db.Uuid
  isDeleted  Boolean?        @default(false) @map("is_deleted")
  deletedAt  DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  isPublic   Boolean?        @default(false) @map("is_public")
  shareToken String?         @map("share_token")
  expiryDate DateTime?       @map("expiry_date") @db.Timestamptz(6)
  aiSessions AiChatSession[]
  diagrams   Diagram[]
  drawings   Drawing[]
  flowcharts Flowchart[]
  notes      Note[]
  user       User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("projects")
  @@schema("public")
}

model Diagram {
  id            BigInt         @id @default(autoincrement())
  uid           String?        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  userId        String?        @map("user_id") @db.Uuid
  projectId     BigInt?        @map("project_id")
  isDeleted     Boolean?       @default(false) @map("is_deleted")
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  viewportX     Float?         @default(0) @map("viewport_x")
  viewportY     Float?         @default(0) @map("viewport_y")
  viewportZoom  Float?         @default(1.0) @map("viewport_zoom")
  version       Int?           @default(0) @map("_version")
  isPublic      Boolean?       @default(false) @map("is_public")
  shareToken    String?        @map("share_token")
  expiryDate    DateTime?      @map("expiry_date") @db.Timestamptz(6)
  publishedAt   DateTime?      @map("published_at") @db.Timestamptz(6)
  sourceType        String? @default("blank") @map("source_type")
  sourceConnectionId Int?   @map("source_connection_id")
  data             String?  @map("data")  // JSON positions untuk production DB
  project       Project?       @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  user          User?          @relation(fields: [userId], references: [id], onUpdate: NoAction)
  entities      Entity[]
  relationships Relationship[]

  @@index([projectId, isDeleted], map: "idx_diagrams_project_deleted")
  @@index([updatedAt(sort: Desc)], map: "idx_diagrams_updated_at")
  @@index([version], map: "idx_diagrams_version")
  @@map("diagrams")
  @@schema("public")
}

model Note {
  id          BigInt    @id @default(autoincrement())
  uid         String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  content     String?   @default("")
  userId      String?   @map("user_id") @db.Uuid
  projectId   BigInt?   @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  shareToken  String?   @map("share_token")
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_notes_project_deleted")
  @@index([updatedAt(sort: Desc)], map: "idx_notes_updated_at")
  @@index([version], map: "idx_notes_version")
  @@map("notes")
  @@schema("public")
}

model Drawing {
  id          BigInt    @id @default(autoincrement())
  uid         String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  data        String?   @default("[]")
  userId      String?   @map("user_id") @db.Uuid
  projectId   BigInt?   @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  shareToken  String?   @map("share_token")
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_drawings_project_deleted")
  @@index([updatedAt(sort: Desc)], map: "idx_drawings_updated_at")
  @@index([version], map: "idx_drawings_version")
  @@map("drawings")
  @@schema("public")
}

model Flowchart {
  id          BigInt    @id @default(autoincrement())
  uid         String?   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  data        String?   @default("{\"nodes\":[], \"edges\":[]}")
  userId      String?   @map("user_id") @db.Uuid
  projectId   BigInt?   @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  shareToken  String?   @map("share_token")
  expiryDate  DateTime? @map("expiry_date") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_flowcharts_project_deleted")
  @@index([updatedAt(sort: Desc)], map: "idx_flowcharts_updated_at")
  @@index([version], map: "idx_flowcharts_version")
  @@map("flowcharts")
  @@schema("public")
}

model Entity {
  id                String         @id
  diagramId         BigInt?        @map("diagram_id")
  name              String
  x                 Float
  y                 Float
  color             String?        @default("#6366f1")
  createdAt         DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  columns           Column[]
  diagram           Diagram?       @relation(fields: [diagramId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "entities_file_id_fkey")
  relationshipsFrom Relationship[] @relation("source_entity")
  relationshipsTo   Relationship[] @relation("target_entity")

  @@map("entities")
  @@schema("public")
}

model Column {
  id         String    @id
  entityId   String?   @map("entity_id")
  name       String
  type       String
  isPk       Boolean?  @default(false) @map("is_pk")
  isNullable Boolean?  @default(true) @map("is_nullable")
  enumValues String?   @map("enum_values")
  sortOrder  Int?      @default(0) @map("sort_order")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  entity     Entity?   @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("columns")
  @@schema("public")
}

model Relationship {
  id             String    @id
  diagramId      BigInt?   @map("diagram_id")
  sourceEntityId String?   @map("source_entity_id")
  targetEntityId String?   @map("target_entity_id")
  sourceColumnId String?   @map("source_column_id")
  targetColumnId String?   @map("target_column_id")
  type           String?   @default("one-to-many")
  sourceHandle   String?   @map("source_handle")
  targetHandle   String?   @map("target_handle")
  label          String?
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  diagram        Diagram?  @relation(fields: [diagramId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "relationships_file_id_fkey")
  sourceEntity   Entity?   @relation("source_entity", fields: [sourceEntityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetEntity   Entity?   @relation("target_entity", fields: [targetEntityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("relationships")
  @@schema("public")
}

model EntityChange {
  id         BigInt    @id @default(autoincrement())
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  version    Int
  userId     String?   @map("user_id") @db.Uuid
  changes    Json
  changeType String?   @default("update") @map("change_type")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([entityType, entityId, version(sort: Desc)], map: "idx_entity_changes_lookup")
  @@index([createdAt(sort: Desc)], map: "idx_entity_changes_retention")
  @@index([userId, createdAt(sort: Desc)], map: "idx_entity_changes_user")
  @@map("entity_changes")
  @@schema("public")
}

model Backup {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  name      String
  status    String    @default("pending")
  filePath  String?   @map("file_path")
  fileSize  BigInt?   @map("file_size")
  destinations String? @map("destinations")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("backups")
  @@schema("public")
}

model AiProvider {
  id          BigInt         @id @default(autoincrement())
  name        String
  code        String         @unique
  baseUrl     String?        @map("base_url")
  isActive    Boolean?       @default(true) @map("is_active")
  createdAt   DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  models      AiModel[]
  userConfigs UserAiConfig[]

  @@map("ai_providers")
  @@schema("public")
}

model AiModel {
  id              BigInt         @id @default(autoincrement())
  providerId      BigInt?        @map("provider_id")
  modelIdentifier String         @map("model_identifier")
  displayName     String         @map("display_name")
  contextWindow   Int?           @map("context_window")
  isActive        Boolean?       @default(true) @map("is_active")
  createdAt       DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  provider        AiProvider?    @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userConfigs     UserAiConfig[]

  @@map("ai_models")
  @@schema("public")
}

model UserAiConfig {
  id              BigInt      @id @default(autoincrement())
  userId          String      @map("user_id") @db.Uuid
  providerId      BigInt?     @map("provider_id")
  selectedModelId BigInt?     @map("selected_model_id")
  apiKey          String      @map("api_key")
  isEnabled       Boolean?    @default(true) @map("is_enabled")
  updatedAt       DateTime?   @default(now()) @map("updated_at") @db.Timestamptz(6)
  provider        AiProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  selectedModel   AiModel?    @relation(fields: [selectedModelId], references: [id], onUpdate: NoAction)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, providerId])
  @@map("user_ai_configs")
  @@schema("public")
}

model AiChatSession {
  id         BigInt          @id @default(autoincrement())
  uid        String?         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  projectId  BigInt?         @map("project_id")
  title      String?         @default("New Conversation")
  createdAt  DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime?       @default(now()) @map("updated_at") @db.Timestamptz(6)
  entityUid  String?         @map("entity_uid")
  entityType String?         @map("entity_type")
  messages   AiChatMessage[]
  project    Project?        @relation(fields: [projectId], references: [id], onUpdate: NoAction)

  @@index([entityType, entityUid], map: "idx_ai_chat_sessions_entity")
  @@index([projectId], map: "idx_ai_chat_sessions_project_id")
  @@map("ai_chat_sessions")
  @@schema("public")
}

model AiChatMessage {
  id            BigInt        @id @default(autoincrement())
  sessionId     BigInt        @map("session_id")
  role          String
  content       String
  selectionText String?       @map("selection_text")
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  session       AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("ai_chat_messages")
  @@schema("public")
}

model AiSystemPrompt {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(255)
  content   String
  category  String    @default("custom") @db.VarChar(50)
  isDefault Boolean?  @default(false) @map("is_default")
  isBuiltIn Boolean?  @default(false) @map("is_built_in")
  userId    String?   @map("user_id") @db.VarChar(255)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("ai_system_prompts")
  @@schema("public")
}

model UserAiRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  viewType  String   @map("view_type")
  content   String   @default("")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, viewType])
  @@map("user_ai_rules")
  @@schema("public")
}

// ── User Preferences (desktop app) ──
model UserPreference {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  backupFolder        String?  @map("backup_folder")
  autoBackupEnabled   Boolean? @default(false) @map("auto_backup_enabled")
  autoBackupInterval  Int?     @default(3600) @map("auto_backup_interval")
  autoBackupRetention Int?     @default(10) @map("auto_backup_retention")
  storageConfig       String?  @map("storage_config")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                User     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("user_preferences")
  @@schema("public")
}



