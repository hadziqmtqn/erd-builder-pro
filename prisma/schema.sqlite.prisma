// ──────────────────────────────────────────────
// SQLite-compatible Prisma schema for desktop mode
// Stripped of PostgreSQL-specific features:
//  - No auth schema models (desktop uses local auth)
//  - No @db.Uuid, @db.VarChar, @db.Timestamptz annotations
//  - No schemas (SQLite has no schema concept)
//  - Int instead of BigInt for auto-increment IDs
//  - Added local User model (not from auth schema)
// ──────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Local user model (desktop auth, not Supabase auth) ──
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  password     String
  isSuperAdmin Boolean? @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  diagrams        Diagram[]
  notes           Note[]
  drawings        Drawing[]
  flowcharts      Flowchart[]
  projects        Project[]
  backups         Backup[]
  entityChanges   EntityChange[]
  userAiConfigs   UserAiConfig[]
  aiChatSessions  AiChatSession[]
  aiSystemPrompts AiSystemPrompt[]
  userAiRules     UserAiRule[]
  preferences     UserPreference?
  sessions        Session[]
  teamMemberships TeamMember[]
  createdTeams    Team[] @relation("TeamCreator")
  teamAuditEvents TeamAuditEvent[] @relation("TeamAuditActor")

  @@map("users")
}

// ── Auth sessions (local auth mode) ──
model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  email     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([token])
  @@map("sessions")
}

// ── Team (Self-host Web only; unused by Desktop/CLI) ──
model Team {
  id                  String       @id @default(uuid())
  name                String
  type                String       @default("team")
  createdBy           String?      @map("created_by")
  status              String       @default("active")
  provisioningSignature String?    @map("provisioning_signature")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at")
  members             TeamMember[]
  projects            Project[]
  creator             User?        @relation("TeamCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  invitations         TeamInvitation[]
  auditEvents         TeamAuditEvent[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("staff")
  status    String   @default("active")
  joinedAt  DateTime @default(now()) @map("joined_at")
  provisioningSignature String? @map("provisioning_signature")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, userId], map: "team_members_team_user_key")
  @@index([userId, status], map: "idx_team_members_user_status")
  @@map("team_members")
}

model TeamInvitation {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  email       String
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([teamId, expiresAt], map: "idx_team_invitations_team_expires")
  @@index([email, acceptedAt], map: "idx_team_invitations_email_accepted")
  @@map("team_invitations")
}

model TeamAuditEvent {
  id         String    @id @default(uuid())
  teamId     String?   @map("team_id")
  actorId    String?   @map("actor_id")
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   String    @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  team       Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  actor      User?     @relation("TeamAuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([teamId, createdAt], map: "idx_team_audit_events_team_created")
  @@index([actorId, createdAt], map: "idx_team_audit_events_actor_created")
  @@map("team_audit_events")
}

// ── Project ──
model Project {
  id             Int             @id @default(autoincrement())
  uid            String?         @unique
  name           String
  userId         String?         @map("user_id")
  teamId         String?         @map("team_id")
  color          String?         @default("#6366f1")
  isDeleted      Boolean?        @default(false) @map("is_deleted")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime?       @default(now()) @map("created_at")
  updatedAt      DateTime?       @default(now()) @map("updated_at")
  version        Int?            @default(0) @map("_version")
  user           User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)
  team           Team?           @relation(fields: [teamId], references: [id], onUpdate: NoAction)
  diagrams       Diagram[]
  dbClients      DbClient[]
  notes          Note[]
  drawings       Drawing[]
  flowcharts     Flowchart[]
  aiChatSessions AiChatSession[]

  @@index([userId, isDeleted], map: "idx_projects_user_deleted")
  @@index([teamId, isDeleted], map: "idx_projects_team_deleted")
  @@index([updatedAt], map: "idx_projects_updated_at")
  @@map("projects")
}

// ── Diagram (ERD) ──
model Diagram {
  id                 Int            @id @default(autoincrement())
  uid                String?        @unique
  name               String
  userId             String?        @map("user_id")
  projectId          Int?           @map("project_id")
  isDeleted          Boolean?       @default(false) @map("is_deleted")
  deletedAt          DateTime?      @map("deleted_at")
  createdAt          DateTime?      @default(now()) @map("created_at")
  updatedAt          DateTime?      @default(now()) @map("updated_at")
  viewportX          Float?         @default(0) @map("viewport_x")
  viewportY          Float?         @default(0) @map("viewport_y")
  viewportZoom       Float?         @default(1.0) @map("viewport_zoom")
  version            Int?           @default(0) @map("_version")
  isPublic           Boolean?       @default(false) @map("is_public")
  publicAccess       String         @default("off") @map("public_access")
  shareToken         String?        @map("share_token")
  shareTokenHash     String?        @map("share_token_hash")
  expiryDate         DateTime?      @map("expiry_date")
  shareExpiresAt     DateTime?      @map("share_expires_at")
  publishedAt        DateTime?      @map("published_at")
  sourceType         String?        @default("blank") @map("source_type")
  sourceConnectionId Int?           @map("source_connection_id")
  data               String?        @map("data") // JSON positions untuk production DB (desktop only)
  dbmlSource         String?        @map("dbml_source")
  repositoryPath     String?        @map("repository_path")
  repositoryRef      String?        @map("repository_ref")
  repositorySourceId String?        @map("repository_source_id")
  user               User?          @relation(fields: [userId], references: [id], onUpdate: NoAction)
  project            Project?       @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  entities           Entity[]
  relationships      Relationship[]
  sqlQueries         SqlQuery[]

  @@index([projectId, isDeleted], map: "idx_diagrams_project_deleted")
  @@index([updatedAt], map: "idx_diagrams_updated_at")
  @@index([version], map: "idx_diagrams_version")
  @@map("diagrams")
}

model SqlQuery {
  id        Int      @id @default(autoincrement())
  uid       String?  @unique @default(uuid())
  diagramId Int      @map("diagram_id")
  groupName String   @default("Ungrouped") @map("group_name")
  name      String
  script    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  diagram   Diagram  @relation(fields: [diagramId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([diagramId], map: "idx_sql_queries_diagram")
  @@map("sql_queries")
}

// ── DB Client (desktop/CLI only, independent from ERD diagrams) ──
model DbClient {
  id              Int             @id @default(autoincrement())
  uid             String          @unique @default(uuid())
  name            String
  userId          String          @map("user_id")
  projectId       Int?            @map("project_id")
  catalogId       Int?            @map("catalog_id")
  legacyDiagramId Int?            @unique @map("legacy_diagram_id")
  isDeleted       Boolean         @default(false) @map("is_deleted")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  version         Int             @default(0) @map("_version")
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  catalog         DbCatalog?      @relation(fields: [catalogId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  layout          DbClientLayout?
  queries         DbClientQuery[]

  @@index([userId, isDeleted], map: "idx_db_clients_user_deleted")
  @@index([projectId, isDeleted], map: "idx_db_clients_project_deleted")
  @@index([catalogId], map: "idx_db_clients_catalog")
  @@map("db_clients")
}

model DbClientLayout {
  id         Int      @id @default(autoincrement())
  dbClientId Int      @unique @map("db_client_id")
  data       String   @default("{\"nodes\":{},\"viewport\":{\"x\":0,\"y\":0,\"zoom\":1}}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  dbClient   DbClient @relation(fields: [dbClientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("db_client_layouts")
}

model DbClientQuery {
  id            Int      @id @default(autoincrement())
  uid           String   @unique @default(uuid())
  dbClientId    Int      @map("db_client_id")
  legacyQueryId Int?     @unique @map("legacy_query_id")
  groupName     String   @default("Ungrouped") @map("group_name")
  name          String
  script        String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  dbClient      DbClient @relation(fields: [dbClientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dbClientId], map: "idx_db_client_queries_client")
  @@map("db_client_queries")
}

// ── Note ──
model Note {
  id          Int       @id @default(autoincrement())
  uid         String?   @unique
  title       String
  content     String?   @default("")
  userId      String?   @map("user_id")
  projectId   Int?      @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  publicAccess String   @default("off") @map("public_access")
  shareToken  String?   @map("share_token")
  shareTokenHash String? @map("share_token_hash")
  expiryDate  DateTime? @map("expiry_date")
  shareExpiresAt DateTime? @map("share_expires_at")
  publishedAt DateTime? @map("published_at")
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_notes_project_deleted")
  @@index([updatedAt], map: "idx_notes_updated_at")
  @@index([version], map: "idx_notes_version")
  @@map("notes")
}

// ── Drawing ──
model Drawing {
  id          Int       @id @default(autoincrement())
  uid         String?   @unique
  title       String
  data        String?   @default("[]")
  userId      String?   @map("user_id")
  projectId   Int?      @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  publicAccess String    @default("off") @map("public_access")
  shareToken  String?   @map("share_token")
  shareTokenHash String? @map("share_token_hash")
  expiryDate  DateTime? @map("expiry_date")
  shareExpiresAt DateTime? @map("share_expires_at")
  publishedAt DateTime? @map("published_at")
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_drawings_project_deleted")
  @@index([updatedAt], map: "idx_drawings_updated_at")
  @@index([version], map: "idx_drawings_version")
  @@map("drawings")
}

// ── Flowchart ──
model Flowchart {
  id          Int       @id @default(autoincrement())
  uid         String?   @unique
  title       String
  data        String?   @default("{\"nodes\":[], \"edges\":[]}")
  userId      String?   @map("user_id")
  projectId   Int?      @map("project_id")
  isDeleted   Boolean?  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @default(now()) @map("updated_at")
  version     Int?      @default(0) @map("_version")
  isPublic    Boolean?  @default(false) @map("is_public")
  publicAccess String    @default("off") @map("public_access")
  shareToken  String?   @map("share_token")
  shareTokenHash String? @map("share_token_hash")
  expiryDate  DateTime? @map("expiry_date")
  shareExpiresAt DateTime? @map("share_expires_at")
  publishedAt DateTime? @map("published_at")
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)
  project     Project?  @relation(fields: [projectId], references: [id], onUpdate: NoAction)

  @@index([projectId, isDeleted], map: "idx_flowcharts_project_deleted")
  @@index([updatedAt], map: "idx_flowcharts_updated_at")
  @@index([version], map: "idx_flowcharts_version")
  @@map("flowcharts")
}

// ── Entity (ERD table) ──
model Entity {
  id                String            @id
  diagramId         Int?              @map("diagram_id")
  name              String
  x                 Float
  y                 Float
  color             String?           @default("#6366f1")
  comment           String?
  createdAt         DateTime?         @default(now()) @map("created_at")
  columns           Column[]
  constraints       TableConstraint[]
  indexes           TableIndex[]
  diagram           Diagram?          @relation(fields: [diagramId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  relationshipsFrom Relationship[]    @relation("source_entity")
  relationshipsTo   Relationship[]    @relation("target_entity")

  @@map("entities")
}

// ── Column (ERD table column) ──
model Column {
  id               String    @id
  entityId         String?   @map("entity_id")
  name             String
  type             String
  isPk             Boolean?  @default(false) @map("is_pk")
  isNullable       Boolean?  @default(true) @map("is_nullable")
  isUnique         Boolean?  @default(false) @map("is_unique")
  defaultValue     String?   @map("default_value")
  enumValues       String?   @map("enum_values")
  comment          String?
  maxLength        Int?      @map("max_length")
  numericPrecision Int?      @map("numeric_precision")
  numericScale     Int?      @map("numeric_scale")
  sortOrder        Int?      @default(0) @map("sort_order")
  createdAt        DateTime? @default(now()) @map("created_at")
  entity           Entity?   @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("columns")
}

// ── Relationship (ERD edge) ──
model Relationship {
  id             String    @id
  diagramId      Int?      @map("diagram_id")
  sourceEntityId String?   @map("source_entity_id")
  targetEntityId String?   @map("target_entity_id")
  sourceColumnId String?   @map("source_column_id")
  targetColumnId String?   @map("target_column_id")
  type           String?   @default("one-to-many")
  sourceHandle   String?   @map("source_handle")
  targetHandle   String?   @map("target_handle")
  label          String?
  onDelete       String?   @map("on_delete")
  onUpdate       String?   @map("on_update")
  constraintName String?   @map("constraint_name")
  createdAt      DateTime? @default(now()) @map("created_at")
  diagram        Diagram?  @relation(fields: [diagramId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sourceEntity   Entity?   @relation("source_entity", fields: [sourceEntityId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  targetEntity   Entity?   @relation("target_entity", fields: [targetEntityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("relationships")
}

model TableConstraint {
  id         String    @id
  entityId   String    @map("entity_id")
  kind       String
  name       String?
  columnIds  String?   @map("column_ids")
  expression String?
  createdAt  DateTime? @default(now()) @map("created_at")
  entity     Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entityId], map: "idx_table_constraints_entity")
  @@map("table_constraints")
}

model TableIndex {
  id        String    @id
  entityId  String    @map("entity_id")
  name      String
  columnIds String    @map("column_ids")
  isUnique  Boolean?  @default(false) @map("is_unique")
  algorithm String?
  createdAt DateTime? @default(now()) @map("created_at")
  entity    Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([entityId], map: "idx_table_indexes_entity")
  @@map("table_indexes")
}

// ── Entity Change (audit log) ──
model EntityChange {
  id         Int       @id @default(autoincrement())
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  version    Int
  userId     String?   @map("user_id")
  changes    String?   @default("{}")
  changeType String?   @default("update") @map("change_type")
  createdAt  DateTime? @default(now()) @map("created_at")
  user       User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([entityType, entityId, version], map: "idx_entity_changes_lookup")
  @@index([createdAt], map: "idx_entity_changes_retention")
  @@index([userId, createdAt], map: "idx_entity_changes_user")
  @@map("entity_changes")
}

// ── Backup ──
model Backup {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  name         String
  status       String    @default("pending")
  filePath     String?   @map("file_path")
  fileSize     Int?      @map("file_size")
  destinations String?   @map("destinations")
  createdAt    DateTime? @default(now()) @map("created_at")
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("backups")
}

// ── AI Provider ──
model AiProvider {
  id          Int            @id @default(autoincrement())
  name        String
  code        String         @unique
  baseUrl     String?        @map("base_url")
  isActive    Boolean?       @default(true) @map("is_active")
  createdAt   DateTime?      @default(now()) @map("created_at")
  updatedAt   DateTime?      @default(now()) @map("updated_at")
  models      AiModel[]
  userConfigs UserAiConfig[]

  @@map("ai_providers")
}

// ── AI Model ──
model AiModel {
  id              Int            @id @default(autoincrement())
  providerId      Int?           @map("provider_id")
  modelIdentifier String         @map("model_identifier")
  displayName     String         @map("display_name")
  contextWindow   Int?           @map("context_window")
  isActive        Boolean?       @default(true) @map("is_active")
  createdAt       DateTime?      @default(now()) @map("created_at")
  provider        AiProvider?    @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userConfigs     UserAiConfig[]

  @@map("ai_models")
}

// ── User AI Config ──
model UserAiConfig {
  id              Int         @id @default(autoincrement())
  userId          String      @map("user_id")
  providerId      Int?        @map("provider_id")
  selectedModelId Int?        @map("selected_model_id")
  apiKey          String?     @map("api_key")
  isEnabled       Boolean?    @default(true) @map("is_enabled")
  updatedAt       DateTime?   @default(now()) @map("updated_at")
  provider        AiProvider? @relation(fields: [providerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  selectedModel   AiModel?    @relation(fields: [selectedModelId], references: [id], onUpdate: NoAction)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, providerId])
  @@map("user_ai_configs")
}

// ── AI Chat Session ──
model AiChatSession {
  id         Int             @id @default(autoincrement())
  uid        String?         @unique
  userId     String?         @map("user_id")
  projectId  Int?            @map("project_id")
  title      String?         @default("New Conversation")
  createdAt  DateTime?       @default(now()) @map("created_at")
  updatedAt  DateTime?       @default(now()) @map("updated_at")
  entityUid  String?         @map("entity_uid")
  entityType String?         @map("entity_type")
  messages   AiChatMessage[]
  project    Project?        @relation(fields: [projectId], references: [id], onUpdate: NoAction)
  user       User?           @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([entityType, entityUid], map: "idx_ai_chat_sessions_entity")
  @@index([projectId], map: "idx_ai_chat_sessions_project_id")
  @@map("ai_chat_sessions")
}

// ── AI Chat Message ──
model AiChatMessage {
  id            Int           @id @default(autoincrement())
  sessionId     Int           @map("session_id")
  role          String
  content       String
  selectionText String?       @map("selection_text")
  clientMessageId String?     @map("client_message_id")
  createdAt     DateTime?     @default(now()) @map("created_at")
  session       AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([sessionId, clientMessageId])
  @@map("ai_chat_messages")
}

// ── AI System Prompt ──
model AiSystemPrompt {
  id        String    @id @default(uuid())
  name      String
  content   String
  category  String    @default("custom")
  isDefault Boolean?  @default(false) @map("is_default")
  isBuiltIn Boolean?  @default(false) @map("is_built_in")
  userId    String?   @map("user_id")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")
  user      User?     @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("ai_system_prompts")
}

// ── User AI Rule ──
model UserAiRule {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  viewType  String   @map("view_type")
  content   String   @default("")
  isEnabled Boolean  @default(true) @map("is_enabled")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, viewType])
  @@map("user_ai_rules")
}

// ── User Preferences (desktop app) ──
model UserPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  backupFolder        String?  @map("backup_folder")
  autoBackupEnabled   Boolean? @default(false) @map("auto_backup_enabled")
  autoBackupInterval  Int?     @default(3600) @map("auto_backup_interval")
  autoBackupRetention Int?     @default(10) @map("auto_backup_retention")
  storageConfig       String?  @map("storage_config")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_preferences")
}

// ── Local Database Connection (desktop-only) ──
// ── DB Account (server-level credentials) ──
model DbAccount {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  name           String
  type           String
  host           String?
  port           Int?
  user           String?
  password       String?
  environment    String   @default("development")
  safeMode       String   @default("protected") @map("safe_mode")
  sslMode        String   @default("disable") @map("ssl_mode")
  sslCa          String?  @map("ssl_ca")
  sslCert        String?  @map("ssl_cert")
  sslKey         String?  @map("ssl_key")
  queryTimeoutMs Int      @default(30000) @map("query_timeout_ms")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  catalogs DbCatalog[]

  @@index([userId], map: "idx_db_accounts_user")
  @@map("db_accounts")
}

// ── DB Catalog (specific database under an account) ──
model DbCatalog {
  id           Int      @id @default(autoincrement())
  accountId    Int      @map("account_id")
  databaseName String   @map("database_name")
  label        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @map("updated_at")

  account   DbAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dbClients DbClient[]

  @@index([accountId], map: "idx_db_catalogs_account")
  @@map("db_catalogs")
}
