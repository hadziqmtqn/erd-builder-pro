{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ERD Builder Pro",
  "mainBinaryName": "ERD Builder Pro",
  "version": "3.3.4",
  "identifier": "com.erdbuilderpro.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3098",
    "beforeDevCommand": "npm run dev:tauri:servers",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "ERD Builder Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {}
    },
    "resources": {
      "../dist-server/index.js": "dist-server/index.js",
      "../dist-server/mcp.js": "dist-server/mcp.js",
      "../dist-server/migrate-db.mjs": "dist-server/migrate-db.mjs",
      "../dist-server/schema.sql": "dist-server/schema.sql",
      "../dist-server/node_modules": "dist-server/node_modules",
      "../dist-server/prisma": "dist-server/prisma",
      "../dist-server/node-bin": "dist-server/node-bin"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/hadziqmtqn/erd-builder-pro/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0QTk2QzQ1NjNEMzA0NjYKUldSbUJOTmpSV3lweEwzUG5uN0N2VStxVW5HVFE0eFM0ZWFwQ0dIR2JBbDZ4Z1gzWG5KSDVHMkUK"
    }
  }
}
