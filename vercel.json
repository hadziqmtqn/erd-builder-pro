{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai/proxy",
      "destination": "/api/ai-proxy.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai-proxy.ts": {
      "maxDuration": 30
    }
  }
}
